	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, WraithwoodForest_EventScript_RematchOttoline
	setvar VAR_0x8004, TRAINER_OTTOLINE
	specialvar VAR_RESULT, IsTrainerRegistered
