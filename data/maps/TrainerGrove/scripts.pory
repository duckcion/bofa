mapscripts TrainerGrove_MapScripts {
    // MAP_SCRIPT_ON_TRANSITION: TrainerGrove_OnTransition
}

script TrainerGrove_EventScript_TrainerOne{
    trainerbattle_single(TRAINER_TRAINERGROVET1, TrainerGrove_Text_Trainer1Intro, TrainerGrove_Text_Trainer1Outro)
    msgbox(TrainerGrove_Text_Trainer1PostBattle, MSGBOX_DEFAULT)
    release
    end
}

script TrainerGrove_EventScript_TrainerTwo{
    trainerbattle_single(TRAINER_TRAINERGROVET2, TrainerGrove_Text_Trainer2Intro, TrainerGrove_Text_Trainer2Outro)
    msgbox(TrainerGrove_Text_Trainer2PostBattle, MSGBOX_DEFAULT)
    release
    end
}

script TrainerGrove_EventScript_TrainerThree{
    trainerbattle_single(TRAINER_TRAINERGROVET3, TrainerGrove_Text_Trainer3Intro, TrainerGrove_Text_Trainer3Outro)
    msgbox(TrainerGrove_Text_Trainer3PostBattle, MSGBOX_DEFAULT)
    release
    end
}

text TrainerGrove_Text_Trainer1Intro{
    "Bring that ass here boy!"
}

text TrainerGrove_Text_Trainer1Outro{
    "Your gyatt was too much for me to handle."
}

text TrainerGrove_Text_Trainer1PostBattle{
    "Damn, you're the goat."
}

text TrainerGrove_Text_Trainer2Intro{
    "Uhh I think I'm in the wrong place."
}

text TrainerGrove_Text_Trainer2Outro{
    "Damn, could you at least get me unstuck stepbro?"
}

text TrainerGrove_Text_Trainer2PostBattle{
    "Arrgghhhh! I'm STUCK!"
}

text TrainerGrove_Text_Trainer3Intro{
    "I came out here to camp, but a battle
sounds even better!"
}

text TrainerGrove_Text_Trainer3Outro{
    "Aww, my campfire went out…"
}

text TrainerGrove_Text_Trainer3PostBattle{
    "The coast is just past here.
Watch out for the tide!"
}

// Split 1: the grove stays closed until Norman (Route 104) asks for the Everstone.
script TrainerGrove_EventScript_PathClosed{
    lockall
    msgbox(TrainerGrove_Text_PathClosed, MSGBOX_DEFAULT)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, TrainerGrove_Movement_StepBack)
    waitmovement(0)
    releaseall
    end
}

movement TrainerGrove_Movement_StepBack{
    walk_up
}

text TrainerGrove_Text_PathClosed{
    "The grove is full of TRAINERS.\nBetter find DAD on ROUTE 104 first."
}
